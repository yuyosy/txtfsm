{
  "name": "txtfsm",
  "displayName": "TxtFSM",
  "version": "0.2.0",
  "private": true,
  "description": "TextFSM template parser",
  "homepage": "https://github.com/yuyosy/txtfsm",
  "bugs": {
    "url": "https://github.com/yuyosy/txtfsm/issues"
  },
  "license": "Apache-2.0",
  "author": "yuyosy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyosy/txtfsm.git"
  },
  "files": [
    "**"
  ],
  "type": "module",
  "main": "./txtfsm.umd.cjs",
  "module": "./txtfsm.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./txtfsm.js",
      "require": "./txtfsm.umd.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc",
    "package:verify": "node ./scripts/verify-package-versions.mjs",
    "package:prepare": "node ./scripts/prepare-package.mjs && npm run package:verify",
    "package:preview": "npm run package:prepare && npm run package:dry-run",
    "package:dry-run": " npm run package:dry-run:npm && npm run package:dry-run:jsr",
    "package:dry-run:npm": "npm pack ./dist --dry-run",
    "package:dry-run:jsr": "npx --yes jsr publish --dry-run",
    "test:watch:unit": "vitest --project unit",
    "test:watch:compat": "vitest --project compat",
    "test:compat:setup": "node ./scripts/fetch-ntc-templates.mjs",
    "test:compat": "npm run test:compat:setup && vitest run --project compat",
    "test:unit": "vitest run --project unit",
    "lint": "oxlint --fix",
    "lint:preview": "oxlint",
    "fmt": "oxfmt",
    "fmt:preview": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "js-yaml": "4.3.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
